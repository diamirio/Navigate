"},{"level":3,"text":"Define your destinations","anchor":"Define-your-destinations","type":"heading"},{"inlineContent":[{"text":"Define your possible destinations in a higher level package in one or more enums.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["import Navigate","","enum MyDestination: NavigationDestination {","    case featureA","    case featureB","    case settings","    case subSettings","    ","    var id: Self { self }","}"],"type":"codeListing"},{"level":4,"text":"Convenience","anchor":"Convenience","type":"heading"},{"inlineContent":[{"type":"text","text":"To be able to write shortenings for your custom destinations, convenience initializers are necessary. These code can be copied from below and adopted accordingly."}],"type":"paragraph"},{"syntax":"swift","code":["extension NavigationLink where Destination == Never {","    ","    \/\/\/ NavigationLink init for `Navigate` framework","    \/\/\/ - Parameters:","    \/\/\/   - destination: The `NavigationDestination` to navigate to","    \/\/\/   - label: The label for the `NavigationLink`","    init(destination: MyDestination, @ViewBuilder label: @escaping () -> Label) {","        self.init(value: destination, label: label)","    }","}","","extension SheetLink {","    \/\/\/ NavigationLink init for `Navigate` framework","    \/\/\/ - Parameters:","    \/\/\/   - destination: The `NavigationDestination` to navigate to","    \/\/\/   - label: The label for the `NavigationLink`","    init(destination: MyDestination, @ViewBuilder label: @escaping () -> Label) {","        self.init(destination: destination as any NavigationDestination, label: label)","    }","}","","extension FullScreenCoverLink {","    \/\/\/ NavigationLink init for `Navigate` framework","    \/\/\/ - Parameters:","    \/\/\/   - destination: The `NavigationDestination` to navigate to","    \/\/\/   - label: The label for the `NavigationLink`","    init(destination: MyDestination, @ViewBuilder label: @escaping () -> Label) {","        self.init(destination: destination as any NavigationDestination, label: label)","    }","}"],"type":"codeListing"},{"level":3,"text":"ModalStack","anchor":"ModalStack","type":"heading"},{"level":4,"text":"Definition","anchor":"Definition","type":"heading"},{"inlineContent":[{"text":"Those ","type":"text"},{"code":"MyDestination","type":"codeVoice"},{"text":"s need to be applied to the first element within a ","type":"text"},{"code":"ModalStack","type":"codeVoice"},{"text":" similar to SwiftUI’s ","type":"text"},{"code":"NavigationStack","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["@State var modalPath: [ModalPathDestination] = []","","var body: some View {","    ModalStack(path: $modalPath) {","        List {","            SheetLink(destination: .featureB) {","                Text(\"Sheet to feature B\")","            }","        }","        .myModalDestinations() \/\/ register all modal destinations","    }","}"],"type":"codeListing"},{"level":4,"text":"Register destinations","anchor":"Register-destinations","type":"heading"},{"syntax":"swift","code":["import Navigate","","\/\/ Import your corresponding views if needed","import FeatureHome ","import FeatureCard","import FeatureSettings","","extension View {","    \/\/\/ SwiftUI navigation destination convenience","    func myNavigtationDestinations() -> some View {","        self.navigationDestination(for: MyDestination.self) { destination in","            switch destination {","            case .featureA:","                FeatureAView()","            case .featureB:","                FeatureBView()","            ...","            }","        }","    }","    ","    \/\/\/ All ModalDestinations wrapped in NavigationStack to support SwiftUI navigation and toolbar","    func myModalDestinations() -> some View {","        self.modalDestination(for: MyDestination.self) { destination in","            switch destination {","            case .featureA:","                NavigationStack {","                    FeatureAView()","                        .myNavigtationDestinations()","                }","            case .featureB:","                NavigationStack {","                    FeatureBView()","                        .myNavigtationDestinations()","                }","            ...","            }","        }","    }","}",""],"type":"codeListing"},{"level":2,"text":"Available SwiftUI links","anchor":"Available-SwiftUI-links","type":"heading"},{"inlineContent":[{"text":"Use the ","type":"text"},{"type":"codeVoice","code":"NavigationLink"},{"text":", ","type":"text"},{"type":"codeVoice","code":"SheetLink"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"FullScreenCoverLink"}],"type":"paragraph"},{"syntax":"swift","code":["List {","    NavigationLink(destination: .featureB) {","        Text(\"Go to feature B\")","    }","","    SheetLink(destination: .featureB) {","        Text(\"Sheet to feature B\")","    }","","    FullScreenCoverLink(destination: .featureB) {","        Text(\"FullScreenCover to feature B\")","    }","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/navigate"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://Navigate/documentation/Navigate/ModalStack":{"kind":"symbol","navigatorTitle":[{"text":"ModalStack","kind":"identifier"}],"role":"symbol","title":"ModalStack","url":"\/documentation\/navigate\/modalstack","type":"topic","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ModalStack","kind":"identifier"}],"identifier":"doc:\/\/Navigate\/documentation\/Navigate\/ModalStack","abstract":[]},"doc://Navigate/documentation/Navigate/SwiftUICore":{"role":"collection","url":"\/documentation\/navigate\/swiftuicore","abstract":[],"type":"topic","title":"SwiftUICore","identifier":"doc:\/\/Navigate\/documentation\/Navigate\/SwiftUICore","kind":"symbol"},"doc://